# Public host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
AI_SERVICE_PORT=8001
NGINX_PORT=8080

# Container ports (normally keep these defaults)
BACKEND_CONTAINER_PORT=8000
FRONTEND_CONTAINER_PORT=80
AI_SERVICE_CONTAINER_PORT=8001

# Docker build contexts and host bind-mount paths
BACKEND_BUILD_CONTEXT=./app/backend
FRONTEND_BUILD_CONTEXT=./app/frontend
AI_MODELS_BUILD_CONTEXT=./ai-models
AI_MODELS_HOST_PATH=./ai-models/models
NGINX_CONFIG_HOST_PATH=./nginx/default.conf.template

BACKEND_SERVICE_HOST=backend
FRONTEND_SERVICE_HOST=frontend
AI_SERVICE_HOST=ai-service

# Service addresses. Use Compose service names for services on this Docker network.
AI_SERVICE_URL=http://ai-service:8001
# Browser-facing backend URL used when building the frontend.
API_URL=http://localhost:8000

# Optional MongoDB history storage. Leave empty to disable it.
MONGODB_URI=
MONGODB_DATABASE=diabetes_db
